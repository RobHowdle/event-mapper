{
	"name": "festival-mapper/festival-mapper",
	"description": "A reusable Laravel package providing an interactive mapping engine for temporary events such as music festivals.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"laravel",
		"festival",
		"map",
		"coordinate",
		"pin",
		"layer"
	],
	"authors": [
		{
			"name": "Festival Mapper Contributors"
		}
	],
	"require": {
		"php": "^8.2",
		"illuminate/support": "^12.0",
		"illuminate/database": "^12.0",
		"illuminate/routing": "^12.0",
		"illuminate/http": "^12.0"
	},
	"require-dev": {
		"orchestra/testbench": "^10.0",
		"phpunit/phpunit": "^11.0",
		"laravel/pint": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"FestivalMapper\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"FestivalMapper\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"FestivalMapper\\FestivalMapperServiceProvider"
			]
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
